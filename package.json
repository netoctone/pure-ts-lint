{
  "name": "pure-ts-lint",
  "version": "0.0.10",
  "description": "TypeScript linter to prioritise pure functions and type safety (beyond TS strict: true). Inspired by eslint-plugin-react-hooks react-hooks/immutability rule. Powered by oxc-parser.",
  "author": "netoctone",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netoctone/pure-ts-lint.git"
  },
  "keywords": [
    "typescript",
    "lint",
    "eslint",
    "functional-programming",
    "functional",
    "fp",
    "pure",
    "immutable",
    "typesafe",
    "type-safe"
  ],
  "type": "module",
  "bin": {
    "ptsl": "dist/lint.js"
  },
  "scripts": {
    "release": "npm run build && npm publish",
    "watch": "tsc --noEmit --watch -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint"
  },
  "dependencies": {
    "glob": "13.0.6",
    "oxc-parser": "0.150.0"
  },
  "devDependencies": {
    "@oxc-project/types": "0.150.0",
    "@types/node": "26.2.0",
    "oxlint": "1.83.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
